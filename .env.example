# =====================================================================
# Netxia Conversational Platform — Variables de entorno
# Copiar como .env y completar con valores reales. NUNCA commitear el
# .env real al repositorio.
# =====================================================================

# --- Entorno general ---
ENVIRONMENT=production
LOG_LEVEL=INFO
ACME_EMAIL=admin@netxia.cl

# --- Base de Datos ---
# NOTA: POSTGRES_HOST=localhost es para scripts que corren FUERA de
# Docker (ej. seed_db.py desde tu máquina). Los contenedores ignoran
# este valor: docker-compose.yml les inyecta POSTGRES_HOST=postgres
# directamente vía `environment:`, que es lo que necesitan para
# resolverse entre ellos dentro de la red de Docker.
POSTGRES_HOST=localhost
POSTGRES_USER=netxia
POSTGRES_PASSWORD=CAMBIAR_ESTA_PASSWORD
POSTGRES_DB=netxia

# --- RabbitMQ ---
RABBITMQ_USER=netxia
RABBITMQ_PASSWORD=CAMBIAR_ESTA_PASSWORD

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_ESTA_PASSWORD
KEYCLOAK_HOSTNAME=auth.netxia.cl

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=CAMBIAR_ESTA_API_KEY
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=CAMBIAR_ESTA_PASSWORD

# --- Asterisk / SIP Trunk (proveedor chileno) ---
SIP_USERNAME=tu_usuario
SIP_PASSWORD=CAMBIAR_ESTA_PASSWORD
SIP_HOST=sip.proveedor.cl
ARI_PASSWORD=CAMBIAR_ESTA_PASSWORD

# --- Modelos LLM ---
DEFAULT_LLM_MODEL=llama3.2:3b
FAST_LLM_MODEL=gemma2:2b
REASONING_LLM_MODEL=mistral:7b

# --- Voz ---
STT_MODEL_SIZE=base
TTS_VOICE=es_ES-sharon-medium

# --- Seguridad ---
JWT_SECRET=CAMBIAR_ESTE_SECRETO_LARGO_Y_ALEATORIO
ENCRYPTION_KEY=CAMBIAR_ESTA_CLAVE_DE_32_BYTES

# --- Notificaciones ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEB3FORMS_ACCESS_KEY=
NOTIFICATION_EMAIL=alertas@netxia.cl

# --- Observabilidad ---
GRAFANA_ADMIN_PASSWORD=CAMBIAR_ESTA_PASSWORD
